# L2 NewEra GameServer image
FROM eclipse-temurin:25-jre-alpine

RUN apk add --no-cache bash gettext util-linux \
    && addgroup -S brproject && adduser -S brproject -G brproject

WORKDIR /l2Brproject

COPY --chown=brproject:brproject libs/ /l2Brproject/libs/
COPY --chown=brproject:brproject game/ /l2Brproject/game/
COPY --chown=brproject:brproject deploy/docker/run-game.sh /l2Brproject/run-game.sh
COPY --chown=brproject:brproject deploy/docker/config/game/server.properties.template /l2Brproject/game/config/server.properties.template
COPY --chown=brproject:brproject deploy/docker/config/hexid.txt.template /l2Brproject/game/config/hexid.txt.template

RUN sed -i 's/\r$//' /l2Brproject/run-game.sh /l2Brproject/game/config/server.properties.template /l2Brproject/game/config/hexid.txt.template \
    && chmod +x /l2Brproject/run-game.sh \
    && mkdir -p /l2Brproject/game/log /l2Brproject/cache \
    && chown -R brproject:brproject /l2Brproject

USER brproject
EXPOSE 7777
ENTRYPOINT ["/l2Brproject/run-game.sh"]
