FROM eclipse-temurin:25-jre-alpine

RUN apk add --no-cache gettext \
    && addgroup -S brproject \
    && adduser -S brproject -G brproject

WORKDIR /opt/brproject

COPY --chown=brproject:brproject libs/server.jar /opt/brproject/app.jar
COPY --chown=brproject:brproject libs/ /opt/brproject/libs/
COPY --chown=brproject:brproject brproject-data/migrations /opt/brproject/brproject-data/migrations
COPY --chown=brproject:brproject deploy/docker/run-migrate.sh /opt/brproject/run-migrate.sh

RUN sed -i 's/\r$//' /opt/brproject/run-migrate.sh \
    && chmod +x /opt/brproject/run-migrate.sh

USER brproject
ENTRYPOINT ["/opt/brproject/run-migrate.sh"]
