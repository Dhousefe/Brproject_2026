# BrProject EditorConfig — consistent style across editors
root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

[*.java]
indent_style = tab
indent_size = 4
tab_width = 4

[*.kt]
indent_style = space
indent_size = 4

[*.kts]
indent_style = space
indent_size = 4

[*.xml]
indent_style = space
indent_size = 4

[*.properties]
indent_style = space
indent_size = 2

[*.yml]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.bat]
end_of_line = crlf
