# ╔══════════════════════════════════════════════════════════╗
# ║  SECURITY WARNING: Change ALL passwords before          ║
# ║  deploying to production. These are LAB-ONLY defaults.  ║
# ╚══════════════════════════════════════════════════════════╝
# BrProject Phase 5 — copy to .env and adjust (never commit .env)
# att-ver-3.0: do not use these defaults on any public/shared host.

# MariaDB
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=l2jdb
MYSQL_USER=brproject
MYSQL_PASSWORD=change-me-app
MYSQL_PORT=3306

# Host-side Flyway (tools/migrate-db.sh)
DB_URL=jdbc:mariadb://localhost:3306/l2jdb?useUnicode=true&characterEncoding=UTF-8
DB_USER=brproject
DB_PASSWORD=change-me-app

# Ports exposed to host
LOGIN_PORT=2106
LOGIN_GS_PORT=9014
GAME_PORT=7777

# JVM
LOGIN_JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC
GAME_JAVA_OPTS=-Xms1g -Xmx2g -XX:+UseG1GC

# Optional: Swing launcher weak credentials (local only)
# BRPROJECT_DEV_AUTH=1
