# L2 NewEra — copy to .env and adjust (never commit .env)
# att-ver-3.0: do not use these defaults on any public/shared host.

# PostgreSQL
POSTGRES_DB=l2jdb
POSTGRES_USER=brproject
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5433
GAME_SERVER_HEXID=3f8a2c7e6b1d4a9085c2e1f7b9d63042
GAME_SERVER_HOST=127.0.0.1

# Host-side Flyway (tools/migrate-db.sh)
DB_URL=jdbc:postgresql://localhost:5433/l2jdb
DB_USER=brproject
DB_PASSWORD=change-me-postgres

# Ports exposed to host
LOGIN_PORT=2106
LOGIN_GS_PORT=9014
GAME_PORT=7777

# JVM
LOGIN_JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC
GAME_JAVA_OPTS=-Xms1g -Xmx2g -XX:+UseG1GC

# Optional: Swing launcher weak credentials (local only)
# BRPROJECT_DEV_AUTH=1
